ar DEF_KEY_DOWN = 40;\\nvar DEF_KEY_HIGHEST = 40;\\t\\/\\/ highest key code\\n\\nvar ROTATED_KEY_LEFT = 38;\\nvar ROTATED_KEY_RIGHT = 40;\\nvar ROTATED_KEY_UP = 39;\\nvar ROTATED_KEY_DOWN = 37;\\n\\n\\/\\/ KEYCODES\\n\\nvar KEY_LEFT = DEF_KEY_LEFT;\\nvar KEY_RIGHT = DEF_KEY_RIGHT;\\nvar KEY_UP = DEF_KEY_UP;\\nvar KEY_DOWN = DEF_KEY_DOWN;"\,"p_valuedescription":""}\,{"p_classes":"d_yesno"\,"p_colour":""\,"p_datatype":"d_yesno"\,"p_info":""\,"p_label":"Is Enabled?"\,"p_length":""\,"p_lines":""\,"p_name":"ISENABLED"\,"p_quantity":"1"\,"p_readonly":""\,"p_required":""\,"p_searchable":""\,"p_selection":""\,"p_sortable":""\,"p_source":""\,"p_style":""\,"p_value":"Y"\,"p_valuedescription":""}]}],sysadmin,2025-02-11 15:15:57,CONSTANTS,Constants,1
