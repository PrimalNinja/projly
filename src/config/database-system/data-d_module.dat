e1f8602"\,"sectioncodetemp":"f7b92ec7-4d8e-462f-8642-1a362e1f8602"\,"sectioncolour":""\,"sectionquantity":"1"\,"sectionref":""\,"sectiontitle":"Form Fields"\,"sectiontype":"DATA"\,"fields":[{"p_classes":"form-control"\,"p_colour":""\,"p_datatype":"d_text"\,"p_info":""\,"p_label":"Code"\,"p_length":"20"\,"p_lines":""\,"p_name":"CODE"\,"p_quantity":"1"\,"p_readonly":""\,"p_required":"Y"\,"p_searchable":"Y"\,"p_selection":""\,"p_sortable":""\,"p_source":""\,"p_style":""\,"p_value":"CLASS_JITP"\,"p_valuedescription":""}\,{"p_classes":"form-control"\,"p_colour":""\,"p_datatype":"d_text"\,"p_info":""\,"p_label":"Description"\,"p_length":"40"\,"p_lines":""\,"p_name":"DESCRIPTION"\,"p_quantity":"1"\,"p_readonly":""\,"p_required":"Y"\,"p_searchable":"Y"\,"p_selection":""\,"p_sortable":""\,"p_source":""\,"p_style":""\,"p_value":"JITP Class"\,"p_valuedescription":""}\,{"p_classes":"form-control d_multilinetext-input"\,"p_colour":""\,"p_datatype":"d_multilinetext"\,"p_info":""\,"p_label":"Notes"\,"p_length":""\,"p_lines":""\,"p_name":"NOTES"\,"p_quantity":""\,"p_readonly":""\,"p_required":""\,"p_searchable":"Y"\,"p_selection":""\,"p_sortable":""\,"p_source":""\,"p_style":""\,"p_value":""\,"p_valuedescription":""}\,{"p_classes":"form-control d_codeeditor-input"\,"p_colour":""\,"p_datatype":"d_codeeditor"\,"p_info":""\,"p_label":"Logic"\,"p_length":""\,"p_lines":"15"\,"p_name":"LOGIC"\,"p_quantity":""\,"p_readonly":""\,"p_required":""\,"p_searchable":""\,"p_selection":""\,"p_sortable":""\,"p_source":""\,"p_style":""\,"p_value":"function JITP()\\n{\\n\\tvar DEF_CALLSPERSECOND = 3;\\t\\/\\/ calls per second\\n\\tvar DEF_URI = 'http:\\/\\/localhost\\/8bitology\\/net\\/ws.php';\\n\\n\\tvar m_intCPS = 0;\\n\\tvar m_intCPSCounter = 0;\\n\\tvar m_intCPSTimer = 0;\\n\\tvar m_objTimer;\\n\\tvar m_objOptions;\\n\\n\\tvar m_blnInCall = false;\\n\\tvar m_intCallID = 0;\\n\\t\\n\\tfunction ajaxCall(strParameters_a\, cbSuccess_a\, cbFailure_a)\\n\\t{\\n\\t\\tm_intCallID++;\\n\\t\\t\\n\\t\\tvar objXHR = new XMLHttpRequest();\\n\\t\\tobjXHR.open('GET'\, m_objOptions.uri + '?id=' + m_intCallID + strParameters_a);\\n\\t\\t\\n\\t\\tobjXHR.onload = function() \\n\\t\\t{\\n\\t\\t\\tif (objXHR.status === 200) \\n\\t\\t\\t{\\n\\t\\t\\t\\tcbSuccess_a(objXHR.responseText);\\n\\t\\t\\t}\\n\\t\\t\\telse \\n\\t\\t\\t{\\n\\t\\t\\t\\tcbFailure_a(objXHR.status);\\n\\t\\t\\t}\\n\\t\\t};\\n\\t\\t\\n\\t\\tobjXHR.send();\\n\\t}\\n\\t\\n\\tfunction processCall()\\n\\t{\\n\\t\\t\\/\\/console.log('processCall');\\n\\n\\t\\tif (!m_blnInCall)\\n\\t\\t{\\n\\t\\t\\tm_blnInCall = true;\\n\\t\\t\\t\\n\\t\\t\\tvar intCPSTimer = performance.now();\\n\\t\\t\\tif (intCPSTimer - m_intCPSTimer <= 1000)\\n\\t\\t\\t{\\n\\t\\t\\t\\tm_intCPSCounter++;\\n\\t\\t\\t}\\n\\t\\t\\telse\\n\\t\\t\\t{\\n\\t\\t\\t\\tif (m_intCPSCounter > 0)\\n\\t\\t\\t\\t{\\n\\t\\t\\t\\t\\tm_intCPS = m_intCPSCounter;\\n\\t\\t\\t\\t\\tm_intCPSCounter = 0;\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tm_intCPSTimer = intCPSTimer;\\n\\t\\t\\t}\\n\\t\\t\\t\\n\\t\\t\\tvar strParameters = '';\\n\\t\\t\\tif (isFunction(m_objOptions.cbOnGetParameters))\\n\\t\\t\\t{\\n\\t\\t\\t\\tstrParameters = m_objOptions.cbOnGetParameters();\\n\\t\\t\\t}\\n\\t\\t\\telse\\n\\t\\t\\t{\\n\\t\\t\\t\\tstrParameters = m_objOptions.cbOnGetParameters;\\n\\t\\t\\t}\\n\\t\\t\\t\\n\\t\\t\\tajaxCall(strParameters\, function(objResponse_a)\\n\\t\\t\\t{\\n\\t\\t\\t\\tif (isFunction(m_objOptions.cbOnProcess))\\n\\t\\t\\t\\t{\\n\\t\\t\\t\\t\\tm_objOptions.cbOnProcess(m_intCallID\, m_intCPS\, objResponse_a);\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tm_blnInCall = false;\\n\\t\\t\\t}\,\\n\\t\\t\\tfunction(strResponse_a)\\n\\t\\t\\t{\\n\\t\\t\\t\\tconsole.log(strResponse_a);\\t\\/\\/ FAILURE\, FOR NOW DON'T DO ANYTHING\\n\\t\\t\\t\\tm_blnInCall = false;\\n\\t\\t\\t});\\n\\t\\t}\\n\\t\\telse\\n\\t\\t{\\n\\t\\t\\t\\/\\/ in a call so we have a process notification\\n\\t\\t\\tif (isFunction(m_objOptions.cbOnProcess))\\n\\t\\t\\t{\\n\\t\\t\\t\\tm_objOptions.cbOnProcess(m_intCallID\, m_intCPS);\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\n\\tthis.process = function(objOptions_a)\\n\\t{\\n\\t\\tm_objOptions = objOptions_a;\\n\\t\\t\\n\\t\\tif (m_objOptions.callspersecond == undefined) { m_objOptions.callspersecond = DEF_CALLSPERSECOND; }\\n\\t\\tif (m_objOptions.uri == undefined) { m_objOptions.uri = DEF_URI; }\\n\\t\\t\\n\\t\\tm_objTimer = setInterval(function()\\n\\t\\t{ \\n\\t\\t\\tprocessCall();\\n\\t\\t}\, 1000 \\/ m_objOptions.callspersecond);\\n\\t\\t\\n\\t\\t\\/\\/m_objTimer = setInterval(processCall);\\n\\t};\\n}"\,"p_valuedescription":""}\,{"p_classes":"d_yesno"\,"p_colour":""\,"p_datatype":"d_yesno"\,"p_info":""\,"p_label":"Is Enabled?"\,"p_length":""\,"p_lines":""\,"p_name":"ISENABLED"\,"p_quantity":"1"\,"p_readonly":""\,"p_required":""\,"p_searchable":""\,"p_selection":""\,"p_sortable":""\,"p_source":""\,"p_style":""\,"p_value":"Y"\,"p_valuedescription":""}]}],sysadmin,2025-02-11 15:10:03,,CLASS_JITP,JITP Class,
